          "shortBursts": {
            "title": "Short bursts feel fastest",
            "description": "New users usually get the cleanest first results when they keep each recording brief.",
            "point1": "Try one or two sentences at a time.",
            "point2": "Pause naturally between ideas.",
            "point3": "You can always record another burst immediately after."
          },
          "quietSpace": {
            "title": "A quieter space makes the first win easier",
            "description": "SilkScribe works best when your voice stands out clearly from the room around you.",
            "point1": "Use the microphone you normally prefer if you have one.",
            "point2": "Keep fans, speakers, or background chatter as low as you can.",
            "point3": "Speak at a steady, normal pace."
          },
          "privacy": {
            "title": "Your setup stays on the essentials",
            "description": "This onboarding avoids extra configuration so you can get to a working first transcription faster.",
            "point1": "Permissions come first because they are critical to the app working correctly.",
