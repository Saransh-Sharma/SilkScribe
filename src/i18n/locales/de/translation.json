          "shortBursts": {
            "title": "Kurze Abschnitte fühlen sich am schnellsten an",
            "description": "Neue Nutzer bekommen meist die saubersten ersten Ergebnisse, wenn jede Aufnahme kurz bleibt.",
            "point1": "Versuche ein oder zwei Sätze auf einmal.",
            "point2": "Pausiere natürlich zwischen Gedanken.",
            "point3": "Du kannst direkt danach sofort erneut aufnehmen."
          },
          "quietSpace": {
            "title": "Eine ruhigere Umgebung macht den ersten Erfolg leichter",
            "description": "SilkScribe funktioniert am besten, wenn sich deine Stimme klar vom Raum abhebt.",
            "point1": "Nutze, wenn möglich, das Mikrofon, das du normalerweise bevorzugst.",
            "point2": "Halte Lüfter, Lautsprecher oder Hintergrundgespräche so leise wie möglich.",
            "point3": "Sprich in gleichmäßigem, normalem Tempo."
          },
          "privacy": {
            "title": "Deine Einrichtung bleibt beim Wesentlichen",
            "description": "Dieses Onboarding vermeidet zusätzliche Konfiguration, damit du schneller zu einer funktionierenden ersten Transkription kommst.",
            "point1": "Berechtigungen kommen zuerst, weil sie entscheidend für die App sind.",
            "point2": "Die Sprach-Engine wird automatisch im Hintergrund ausgewählt.",
            "point3": "Feinabstimmungen kannst du später vornehmen, sobald der Grundablauf funktioniert."
          },
          "firstWin": {
            "title": "Der nächste Bildschirm ist keine Fake-Demo",
            "description": "Du probierst gleich eine echte Push-to-Talk-Transkription in der App aus.",
            "point1": "Lass das Übungsfeld fokussiert.",
            "point2": "Verwende dein normales Tastenkürzel genauso, wie du es später nutzen wirst.",
