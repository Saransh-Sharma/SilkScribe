          "shortcutHabit": {
            "title": "一個快捷鍵、一個簡單習慣",
            "description": "SilkScribe 的操作節奏很簡單：按住、說話、放開。",
            "point1": "說話時按住 {{shortcut}}。",
            "point2": "說完就放開。",
            "point3": "SilkScribe 會立刻把這段短語音變成文字。"
          },
          "focusField": {
            "title": "把焦點放在你想輸入文字的位置",
            "description": "SilkScribe 會把結果送到轉寫完成時仍然處於作用中的欄位。",
            "point1": "在開始說話前，先點一下你想輸入的文字欄位。",
            "point2": "保持那個欄位有焦點，直到轉寫完成。",
            "point3": "在 onboarding 過程中，我們特別提供了一個練習欄位。"
          },
          "shortBursts": {
            "title": "短句通常感覺最快",
            "description": "新使用者在每次錄音都保持簡短時，通常能得到最乾淨的初次結果。",
            "point1": "一次說一到兩句話即可。",
            "point2": "在不同想法之間自然停頓。",
            "point3": "之後你也可以立刻再錄下一段。"
          },
          "quietSpace": {
            "title": "安靜一點的環境更容易獲得第一次成功",
            "description": "當你的聲音能清楚從環境中脫穎而出時，SilkScribe 會表現得最好。",
            "point1": "如果可以，使用你平常偏好的麥克風。",
            "point2": "盡量降低風扇、喇叭或背景談話的聲音。",
            "point3": "用穩定自然的速度說話。"
          },
          "privacy": {
            "title": "設定流程只保留必要內容",
            "description": "這個 onboarding 避免額外設定，好讓你更快完成第一次可用的轉寫。",
            "point1": "權限放在第一步，因為它們對應用程式能否正常運作很關鍵。",
            "point2": "語音引擎會在背景自動挑選。",
            "point3": "等基本流程跑通後，你之後再細調設定也不遲。"
          },
          "firstWin": {
            "title": "下一個畫面不是假的展示",
            "description": "你即將在真正的應用程式中試用一次真實的按住說話轉寫。",
            "point1": "保持練習欄位有焦點。",
            "point2": "像你之後實際使用時一樣使用平常的快捷鍵。",
            "point3": "如果欄位中出現文字，就代表 SilkScribe 已經可以投入實際使用。"
          }
        }
      }
    },
