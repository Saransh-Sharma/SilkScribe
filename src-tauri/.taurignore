# Paths the `tauri dev` file watcher must ignore.
#
# `resources/local-runtime/` is a ~1.5 GB vendored Python runtime for the
# workspace speech/notes workers, generated by `bun run local:runtime` and
# gitignored. Without this entry the dev watcher treats every file in it as a
# source change: generating or moving it triggers thousands of full rebuilds,
# which will fill the disk.
resources/local-runtime/

# Generated model payloads, same reasoning.
resources/models/
